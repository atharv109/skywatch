   "label": "hi",
   "note": "first contact - grants consent (text+voice), starts signup",
   "payload": {
    "event": "messages",
    "space": { "id": "any;-;+15551230001", "platform": "iMessage", "type": "dm", "phone": "+15551239999" },
    "message": {
     "id": "spc-msg-00000000-0000-4000-8000-000000000001",
     "platform": "iMessage",
     "direction": "inbound",
     "timestamp": "2026-10-17T19:06:32.000Z",
     "sender": { "id": "+15551230001", "platform": "iMessage" },
     "space": { "id": "any;-;+15551230001", "platform": "iMessage", "type": "dm", "phone": "+15551239999" },
     "content": { "type": "text", "text": "hi" }
    }
   }
  },
