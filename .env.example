# Copy to .env and fill in. Booleans: REPLAY=0|1. Numbers: PORT.

# MongoDB Atlas connection string (required for any DB-backed route)
MONGODB_URI=

# LLM rendering
GEMINI_API_KEY=

# Env data feeds
AIRNOW_API_KEY=
WSDOT_ACCESS_CODE=

# Photon (iMessage/SMS delivery)
PERCEPTRON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
PHOTON_WEBHOOK_SIGNING_SECRET=

# Voice
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID_BRIEF=
ELEVENLABS_AGENT_ID_CHECKIN=
ELEVENLABS_VOICE_WEBHOOK_SECRET=

# Server
PUBLIC_BASE_URL=http://localhost:3000
REPLAY=0
PORT=3000